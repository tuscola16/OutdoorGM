rules_version = '2';

// Firebase Storage rules for ration-card photos (the meal/food picture loop,
// Rules 6–9). Photos live at games/{gameId}/rations/{playerId}/{file}.
//
// IMPORTANT: Storage rules CANNOT read Firestore — `firestore.get()/exists()` are a
// Firestore-rules-only feature and are invalid here (they compile to an error and
// deny the request). So membership can't be checked in these rules. Instead:
//   • A player may only write/read under their OWN uid path (request.auth.uid ==
//     playerId), which is all the abuse protection we need (plus a size cap).
//   • GMs review photos via the tokenized download URL saved on the ration doc
//     (getDownloadURL()), which grants read without a rules check — so the read rule
//     here only needs to cover direct-path access by the owning player.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    match /games/{gameId}/rations/{playerId}/{fileName} {
      // Direct-path read by the owning player. GM review uses the download URL token.
      allow read: if isSignedIn() && request.auth.uid == playerId;

      // A player uploads only to their own uid path, a reasonably sized image
      // (cap 10 MB; must be an image when the contentType is set — putFile doesn't
      // always populate it, and calling .matches() on null would error the rule).
      allow write: if isSignedIn()
        && request.auth.uid == playerId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('image/.*'));
    }

    // Custom arena map overlay (#42): one image per game, georeferenced onto the map.
    // Storage rules can't read Firestore (see the note above), so GM-only *write* can't be
    // enforced here. Two things close the gap instead:
    //   1. The path is namespaced by uploader uid, so nobody can write over the object a
    //      GM has already published. (A flat `overlay/arena.jpg` was substitutable: any
    //      signed-in account could swap the live arena image for arbitrary content. That
    //      an unreferenced *new* upload is inert doesn't help once the path is referenced.)
    //   2. The overlay is only ever rendered from the download URL a GM saves onto the game
    //      doc, and firestore.rules restricts that field to GMs — so a stranger's upload
    //      under their own uid is never displayed to anyone.
    // Plus the usual signed-in + size + image-type gates.
    // Reads are `isSignedIn()`: membership isn't checkable here, and the tokenized download
    // URL (which only a GM can publish) is the real access boundary.
    match /games/{gameId}/overlay/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('image/.*'));
    }
  }
}
